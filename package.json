{
	"name": "pi-chat-helper",
	"version": "0.2.0",
	"type": "module",
	"description": "pi coding agent 扩展包：浏览器会话轨迹回放 + TUI 提问跳转面板（trajectory web viewer + question panel）",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zhubblego/pi-chat-helper.git"
	},
	"homepage": "https://github.com/zhubblego/pi-chat-helper#readme",
	"bugs": {
		"url": "https://github.com/zhubblego/pi-chat-helper/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"trajectory",
		"session-viewer",
		"tui"
	],
	"engines": {
		"node": ">=18"
	},
	"pi": {
